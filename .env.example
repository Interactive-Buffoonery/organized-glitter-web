# Application environment

# Copy this file to `.env` and update the values for your deployment.
# Do not commit `.env` to version control.

## Frontend (Vite)

# Required for production builds. Defaults to http://localhost:8090 in dev when unset.
VITE_POCKETBASE_URL=http://localhost:8090

# Public site origin used for metadata, canonical URLs, and sitemap generation.
VITE_APP_URL=http://localhost:5173

# Build identifier shown in diagnostics and update checks.
VITE_APP_VERSION=local-build

# Optional operator contact shown in support and limit messages.
# VITE_CONTACT_EMAIL=admin@example.test

# Optional external support page URL.
# VITE_SUPPORT_URL=https://example.test/support

# Optional App Store listing, linked from the support page.
# VITE_APP_STORE_URL=https://apps.apple.com/app/id0000000000

## PostHog analytics (optional)

# Analytics stay disabled when these are unset.
# VITE_PUBLIC_POSTHOG_KEY=phc_your_key_here
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

## PocketBase admin (tooling only)

# Used by schema validation, type generation, and bootstrap scripts.
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.test
POCKETBASE_ADMIN_PASSWORD=change-me-local-only

## Local PocketBase development

LOCAL_POCKETBASE_URL=http://localhost:8090
LOCAL_POCKETBASE_ADMIN_EMAIL=admin@localhost.dev
LOCAL_POCKETBASE_ADMIN_PASSWORD=admin123456
LOCAL_POCKETBASE_TEST_USER_EMAIL=local-user@example.test
LOCAL_POCKETBASE_TEST_USER_PASSWORD=local-test-password-123

## Feedback mail (server-side)

# PocketBase feedback hook recipient. Leave unset to disable delivery safely.
# FEEDBACK_TO_EMAIL=admin@example.test

## Legacy Node feedback adapter (optional)

# FEEDBACK_FROM_EMAIL=feedback@example.test
# FEEDBACK_ALLOWED_ORIGINS=http://localhost:5173
# FEEDBACK_BODY_LIMIT_BYTES=16384
# FEEDBACK_RATE_LIMIT_MAX=5
# FEEDBACK_RATE_LIMIT_WINDOW_MS=900000
# FEEDBACK_RATE_LIMIT_MAX_WINDOWS=10000
# Defaults to 0. Only opt in behind a trusted proxy that overwrites IP headers.
# FEEDBACK_TRUSTED_PROXY_HOPS=1
# RESEND_API_KEY=

## Optional sourcemap upload (ops only)

# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=

# Optional full website publishing. No WordPress fetch occurs without its API URL.
# BLOG_ENABLED=true
# WORDPRESS_API_URL=https://content.example.test/wp-json/wp/v2
# WORDPRESS_CONTACT_URL=https://content.example.test/contact/
# MAILPOET_IFRAME_URL=https://content.example.test/?mailpoet_form_iframe=1
# NEWSLETTER_SIGNUP_URL=https://content.example.test/#subscribe
# VITE_UPDATES_URL=http://localhost:3000/updates/
# Optional one-time tips via Stripe Payment Links. Tips stay hidden until at least one is set.
# VITE_STRIPE_TIP_2_URL=https://buy.stripe.com/test_example
# VITE_STRIPE_TIP_3_URL=
# VITE_STRIPE_TIP_5_URL=
# VITE_STRIPE_TIP_10_URL=
# VITE_STRIPE_TIP_CUSTOM_URL=
# VITE_SOURCE_URL=https://github.com/Interactive-Buffoonery/organized-glitter-web
# POSTHOG_PROXY_HOST=https://us.i.posthog.com
# POSTHOG_PROXY_ASSET_HOST=https://us-assets.i.posthog.com
# APPLE_APP_IDS=AAAAAAAAAA.test.example.app

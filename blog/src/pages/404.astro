---
import BlogLayout from '../layouts/BlogLayout.astro';
---

<BlogLayout
  title="Page not found"
  description="This Organized Glitter update could not be found."
  canonicalPath="/updates/"
>
  <div class="not-found">
    <h1>Page not found</h1>
    <p>This update may have moved or been removed.</p>
    <a class="back-link" href="/updates/">All updates</a>
  </div>
</BlogLayout>

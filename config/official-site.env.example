# Public configuration for the official site. No credentials belong here.
# Ops injects these values when building and serving a pinned public revision.
VITE_APP_URL=https://organizedglitter.app
VITE_POCKETBASE_URL=https://data.organizedglitter.app
VITE_UPDATES_URL=https://organizedglitter.app/updates/
VITE_SUPPORT_URL=/contact
VITE_CONTACT_EMAIL=contact@organizedglitter.app
BLOG_ENABLED=true
WORDPRESS_API_URL=https://updates.organizedglitter.app/wp-json/wp/v2
WORDPRESS_CONTACT_URL=https://updates.organizedglitter.app/contact/
MAILPOET_IFRAME_URL=https://updates.organizedglitter.app/?mailpoet_form_iframe=1
NEWSLETTER_SIGNUP_URL=https://updates.organizedglitter.app/#subscribe
APPLE_APP_IDS=7CNK4YPCQX.com.interactivebuffoonery.organizedglitter
# Tips stay hidden until ops supplies the live Stripe Payment Link URLs.
# VITE_STRIPE_TIP_2_URL=
# VITE_STRIPE_TIP_3_URL=
# VITE_STRIPE_TIP_5_URL=
# VITE_STRIPE_TIP_10_URL=
# VITE_STRIPE_TIP_CUSTOM_URL=
# Set VITE_APP_STORE_URL to the public App Store listing to offer reviews on /support.
# Set VITE_APP_VERSION to the immutable public commit used by the deployment.
# Set VITE_SOURCE_URL to https://github.com/Interactive-Buffoonery/organized-glitter-web/tree/<commit>
# Analytics remain disabled until ops supplies both the public project key and host.
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=/glimmer
# POSTHOG_PROXY_HOST=https://us.i.posthog.com
# POSTHOG_PROXY_ASSET_HOST=https://us-assets.i.posthog.com
# Mail sender/recipient, provider credentials and signing keys are managed by ops.
PUBLIC_IMAGE_ORIGINS=https://images.organizedglitter.app,https://organized-glitter-images.diamondartchive.workers.dev

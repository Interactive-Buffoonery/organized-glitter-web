/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; connect-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://i.ytimg.com data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/updates/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/.well-known/apple-app-site-association
  Content-Type: application/json; charset=utf-8
